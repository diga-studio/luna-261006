{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
