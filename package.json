{
  "name": "fts5-doc-index",
  "version": "0.1.0",
  "private": true,
  "description": "Online full-text index for a document collection, backed by SQLite FTS5 in a single file",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
