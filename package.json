{
  "name": "identity-resolution",
  "version": "0.1.0",
  "private": true,
  "description": "客户身份纠错与档案重组库（进程内存版）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
